#!/usr/bin/env python3
"""mintrun vault plugin: keeps each master secret as a Bitwarden secure note named mintrun/<key>.

Needs the Bitwarden CLI (bw), logged in and unlocked: export BW_SESSION="$(bw unlock --raw)".
mintrun sends one JSON request on stdin and reads one JSON reply on stdout.
"""
import base64
import json
import os
import re
import shutil
import subprocess
import sys

REDACTED = "[MINTRUN:REDACTED]"
UUID = re.compile(r"[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}")
SECRETS = []  # scrubbed from every error this plugin returns


class Fail(Exception):
    """An error written for the user. main() still scrubs SECRETS from it."""


def scrub(text):
    for s in sorted(SECRETS, key=len, reverse=True):
        for form in (s, json.dumps(s)[1:-1]):
            if form:
                text = text.replace(form, REDACTED)
    return text


def bw(*args, stdin=""):
    path = shutil.which("bw")
    if not path or not os.path.isabs(path):
        raise Fail("bw not found on PATH (install the Bitwarden CLI)")
    try:
        p = subprocess.run([path, "--nointeraction"] + list(args), input=stdin, capture_output=True,
                           encoding="utf-8", errors="replace", timeout=120)
    except subprocess.TimeoutExpired:
        raise Fail("bw %s timed out" % args[0])
    if p.returncode != 0:
        # stdout is never quoted: it can hold the item, notes included.
        raise Fail("bw %s failed: %s" % (args[0], p.stderr.strip()))
    return p.stdout


def find(name):
    """The one personal, live secure note called name, or None. Two of them are an error, never a guess."""
    items = json.loads(bw("list", "items", "--search", name))
    # Personal vault only: a note an organization shares could be planted by another member.
    mine = [i for i in items if i.get("name") == name and i.get("type") == 2
            and i.get("organizationId") is None and i.get("deletedDate") is None]
    if len(mine) > 1:
        raise Fail("%d Bitwarden secure notes are named %s: delete all but one" % (len(mine), name))
    if mine and not UUID.fullmatch(str(mine[0].get("id"))):
        raise Fail("bw returned an item id that is not a UUID")
    return mine[0] if mine else None


def handle(req):
    op, name = req.get("op"), "mintrun/" + req.get("key", "")
    if op not in ("get_secret", "set_secret", "delete_secret"):
        raise Fail("bitwarden is a vault plugin and does not support %s" % op)
    session = os.environ.get("BW_SESSION", "")
    if not session:
        raise Fail('BW_SESSION is not set: unlock first with export BW_SESSION="$(bw unlock --raw)"')
    SECRETS.append(session)

    if op == "get_secret":
        item = find(name)
        if not item or not item.get("notes"):
            raise Fail("no Bitwarden secure note named %s (run bw sync if you added it on another device)" % name)
        return {"value": item["notes"]}

    if op == "set_secret":
        value = req.get("value", "")
        SECRETS.append(value)
        if not value.strip():
            raise Fail("refusing to store an empty secret")
        item = find(name)
        if item is None:
            args = ("create", "item")
            item = {"type": 2, "name": name, "notes": value, "secureNote": {"type": 0}, "organizationId": None,
                    "folderId": None, "favorite": False, "fields": [], "reprompt": 0}
        else:
            args = ("edit", "item", item["id"])
            item["notes"] = value
        # Left out of argv, the base64 JSON is read from stdin, so the secret never shows in ps.
        payload = base64.b64encode(json.dumps(item).encode()).decode()
        SECRETS.append(payload)
        bw(*args, stdin=payload)
        return {}

    item = find(name)
    if item is None:
        raise Fail("no Bitwarden secure note named %s" % name)
    bw("delete", "item", item["id"])  # to the trash, where it can still be restored
    return {}


def main():
    try:
        out = handle(json.loads(sys.stdin.buffer.read()))
    except Fail as e:
        out = {"error": scrub(str(e))}
    except Exception as e:  # its text can quote a secret, so only its type is reported
        out = {"error": "unexpected %s" % type(e).__name__}
    json.dump(out, sys.stdout)


if __name__ == "__main__":
    main()
